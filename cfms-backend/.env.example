NODE_ENV=development
PORT=4000

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://cfms_user:cfms_password@localhost:5432/cfms_db

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# OCR.space API key, used to autofill the payment form from a screenshot
# (https://ocr.space/ocrapi — free tier key works for testing).
OCRSPACE_API_KEY=replace_with_your_ocrspace_api_key

# Real bank transaction verification API — not wired up yet. Currently
# src/utils/bankVerification.js is a STUB that always confirms a
# well-formed transaction ID. See that file for what to replace once you
# have real credentials/endpoint for this.
# BANK_VERIFY_API_URL=
# BANK_VERIFY_API_KEY=
