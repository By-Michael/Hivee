generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // platform-level (Anthropic-style SaaS owner) — manages all communities
  ADMIN       // committee member — manages one community
  RESIDENT
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SECURITY
  WATER
  CLEANING
  MAINTENANCE
  IMPROVEMENT
  ADMIN
  OTHER
}

// ---------------------------------------------------------------------------
// TENANT ROOT
// ---------------------------------------------------------------------------

model Community {
  id          String   @id @default(uuid())
  name        String
  address     String?
  contactInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  fees     Fee[]
  funds    Fund[]
  projects Project[]

  @@map("communities")
}

// ---------------------------------------------------------------------------
// CORE ENTITIES
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  communityId  String?  // nullable so SUPER_ADMIN can exist without a tenant
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RESIDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  community     Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  resident      Resident?
  refreshTokens RefreshToken[]
  verifiedPayments Payment[]  @relation("PaymentVerifiedBy")
  recordedExpenses Expense[]  @relation("ExpenseRecordedBy")

  @@index([communityId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Resident {
  id         String         @id @default(uuid())
  userId     String         @unique
  unitNumber String
  status     ResidentStatus @default(ACTIVE)
  joinedAt   DateTime       @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("residents")
}

model Fee {
  id          String       @id @default(uuid())
  communityId String
  name        String
  amount      Decimal      @db.Decimal(12, 2)
  frequency   FeeFrequency @default(MONTHLY)
  dueDay      Int? // day of month/quarter fee is due
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([communityId])
  @@map("fees")
}

model Payment {
  id                 String        @id @default(uuid())
  residentId         String
  feeId              String
  amount             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  transactionReference String?
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime      @default(now())
  verifiedBy         String?

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  fee      Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  verifier User?    @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([residentId])
  @@index([feeId])
  @@map("payments")
}

model Fund {
  id          String   @id @default(uuid())
  communityId String
  name        String
  description String?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([communityId])
  @@map("funds")
}

model Project {
  id          String        @id @default(uuid())
  communityId String
  fundId      String
  name        String
  description String?
  budget      Decimal       @db.Decimal(12, 2)
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fund      Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([communityId])
  @@index([fundId])
  @@map("projects")
}

model Expense {
  id          String          @id @default(uuid())
  projectId   String?
  recordedBy  String
  category    ExpenseCategory @default(OTHER)
  description String?
  vendor      String?
  amount      Decimal         @db.Decimal(12, 2)
  spentAt     DateTime        @default(now())

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recorder User      @relation("ExpenseRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
  receipts Receipt[]

  @@index([projectId])
  @@map("expenses")
}

model Receipt {
  id         String   @id @default(uuid())
  expenseId  String
  fileUrl    String
  uploadedAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("receipts")
}
