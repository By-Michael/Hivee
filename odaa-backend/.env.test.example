# Copy this to .env.test and point it at a database used ONLY for tests
# (never your dev or production database — tests TRUNCATE every table
# between runs, see tests/testDb.js). Easiest: a second, free Supabase
# project just for testing.
#
# Include "test" in the name/URL so tests/env.setup.js's safety check
# doesn't warn on every run.
DATABASE_URL=postgresql://odaa_user:odaa_password@localhost:5432/odaa_test_db

# Optional — tests/env.setup.js fills in safe defaults for these if unset,
# but you can override them here.
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
