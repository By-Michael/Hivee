NODE_ENV=development
PORT=4000

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://odaa_user:odaa_password@localhost:5432/odaa_db

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d

CORS_ORIGIN=http://localhost:5173
# In production this MUST be your real deployed frontend URL (comma-separate
# multiple origins if needed, e.g. prod + a preview URL). It cannot be left
# unset/wildcard: auth relies on a credentialed (cookie) cross-origin
# request, which browsers refuse to allow against a wildcard origin.

# Base URL of the deployed frontend, used to build the link inside
# password-reset emails (e.g. https://app.example.com/reset-password?token=...).
FRONTEND_URL=http://localhost:5173

# OCR.space API key, used to autofill the payment form from a screenshot
# (https://ocr.space/ocrapi — free tier key works for testing).
OCRSPACE_API_KEY=replace_with_your_ocrspace_api_key

# Groq API key — after OCR.space extracts raw text from a payment
# screenshot, this is used to turn that unstructured text into labeled
# fields (amount, sender name, transaction ID, bank name, date). Optional:
# if unset, the app falls back to regex-only extraction (txnId + name
# only, no amount/bank/date) with no error to the user.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_replace_me
# GROQ_MODEL=llama-3.1-8b-instant

# Outbound email (e.g. resident-deactivation notices), via SMTP. If any of
# these are unset, src/utils/email.js runs in STUB MODE — emails are
# logged to the console instead of actually sent, so local dev works
# without real mail credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace_with_smtp_username
# SMTP_PASS=replace_with_smtp_password
# SMTP_FROM="ODAA <no-reply@example.com>"

# Bank transaction verification, via Veritas (https://veritas.et) — an
# UNOFFICIAL third-party Ethiopian payment-verification service (not the
# banks themselves). Required for src/utils/bankVerification.js to do real
# lookups; without it, the app falls back to STUB MODE and logs a loud
# warning on boot (see server.js) — self-verified payments are NOT checked
# against a real bank in that mode.
# VERITAS_API_KEY=sk_live_replace_me
# Only set this if you're running your own Veritas API fork — otherwise
# leave unset to use the hosted API (https://verifyapi.leulzenebe.pro).
# VERITAS_API_URL=

# Supabase Storage, for receipt file uploads. Required in production
# (e.g. on Render, whose filesystem is ephemeral and wipes local uploads
# on every deploy/restart) — without these, receipts fall back to local
# disk storage, which is fine for local dev only. Use the SERVICE ROLE
# key (Project Settings -> API in the Supabase dashboard), not the anon
# key — uploads happen from trusted backend code after our own auth
# middleware, not directly from the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Storage bucket to upload receipts into. Create it in the Supabase
# dashboard (Storage -> New bucket) — "Public" so fileUrl works directly
# in <img>/<a> tags without needing signed URLs. Defaults to "receipts".
# SUPABASE_RECEIPTS_BUCKET=receipts
