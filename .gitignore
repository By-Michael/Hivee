# ---- Dependencies ----
node_modules/
hivee-backend/node_modules/
hivee-frontend/node_modules/

# ---- Env / secrets ----
.env
.env.local
.env.*.local
hivee-backend/.env
hivee-frontend/.env

# ---- Build output ----
dist/
build/
hivee-frontend/dist/

# ---- Vite cache ----
.vite/
hivee-frontend/.vite/
hivee-frontend/node_modules/.vite/

# ---- Uploads (receipts etc.) ----
hivee-backend/uploads/*
!hivee-backend/uploads/.gitkeep

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---- Prisma ----
hivee-backend/prisma/*.db
hivee-backend/prisma/migrations/dev/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Test/coverage ----
coverage/
test/
